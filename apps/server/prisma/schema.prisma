generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── ENUMS (modelled as String on SQLite) ───────────────
// SQLite has no native enums. These were Postgres enums; the values are still
// enforced at the API boundary by Zod schemas, and the shared @bakery/types
// expose them as string unions. Documented here for reference:
//   UserRole              : admin | cashier | baker | owner
//   PaymentMethod         : cash | momo | card | credit
//   ProductionBatchStatus : in_progress | completed | failed
//   SalesOrderStatus      : draft | confirmed | picked | invoiced | paid | cancelled
//   ExpenseCategory       : utilities | wages | packaging | ingredients | maintenance | other
//   DocumentTemplateType  : invoice | receipt | packing_slip | purchase_order | label
//   AuditEntity           : sales_order | sales_order_item | payment | product | user
//   AuditAction           : create | update | delete | status_change | item_added |
//                           item_quantity_changed | item_removed | payment_added |
//                           payment_voided | password_reset

// ─── MODELS ─────────────────────────────────────────────

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                String
  isActive            Boolean  @default(true)
  // Set true after an admin resets a staff password. The next login forces a
  // change-password prompt before any other route loads. Cleared on success.
  mustChangePassword  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  salesOrders       SalesOrder[]
  productionBatches ProductionBatch[]
  expenses          Expense[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders     SalesOrder[]

  @@map("locations")
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?  @unique
  address       String?
  notes         String?
  isActive      Boolean  @default(true)
  creditBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrders SalesOrder[]

  @@map("customers")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String   @unique
  category       String
  // sellingPrice = what the cashier charges at POS (stored in cents).
  // costPrice    = what it costs the bakery to produce one unit (cents).
  // Margin per unit = sellingPrice - costPrice.
  sellingPrice   Int      @map("price")
  costPrice      Int      @default(0) @map("wholesalePrice")
  unit           String   @default("pcs")
  description    String?
  imageUrl       String?
  isAvailable    Boolean  @default(true)
  isActive       Boolean  @default(true)
  stockQuantity  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants           ProductVariant[]
  salesOrderItems    SalesOrderItem[]
  dailyTargets       DailyProductionTarget[]
  productionBatches  ProductionBatch[]
  stockAdjustments   ProductStockAdjustment[]

  @@map("products")
}



model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  price     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product         Product          @relation(fields: [productId], references: [id])
  salesOrderItems SalesOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductStockAdjustment {
  id             String   @id @default(cuid())
  productId      String
  quantityChange Float
  reason         String
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@map("product_stock_adjustments")
}

model ProductionBatch {
  id               String    @id @default(cuid())
  productId        String
  batchSequence    Int       @unique
  batchNumber      String    @unique
  quantityProduced Float
  quantityUnit     String
  status           String    @default("in_progress")
  producedBy       String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  notes            String?

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [producedBy], references: [id])

  @@map("production_batches")
}

model DailyProductionTarget {
  id                  String   @id @default(cuid())
  targetDate          DateTime // Day-granularity; stored as DateTime on SQLite
  productId           String
  targetQty           Int      @default(0)
  carriedOverShortage Int      @default(0)
  actualQty           Int      @default(0)
  shortage            Int      @default(0)
  status              String   @default("in_progress")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([targetDate, productId])
  @@map("daily_production_targets")
}

model SalesOrder {
  id             String    @id @default(cuid())
  orderSequence  Int       @unique
  orderNumber    String    @unique
  customerId     String?
  locationId     String
  processedBy    String
  status         String    @default("draft")
  subtotal       Int       @default(0)
  taxTotal       Int       @default(0)
  total          Int       @default(0)
  amountPaid     Int       @default(0)
  balanceDue     Int       @default(0)
  notes          String?
  completedAt    DateTime?
  // Stamped whenever items are added/edited/removed after creation — drives
  // the "Edited" badge in Sales Records and the audit-trail queries.
  lastModifiedAt DateTime?
  lastModifiedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer?       @relation(fields: [customerId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])
  user     User            @relation(fields: [processedBy], references: [id])
  items    SalesOrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String @id @default(cuid())
  salesOrderId  String
  productId     String
  variantId     String?
  quantity      Int
  // unitPrice    = selling-price snapshot per unit at the time of sale.
  // unitCostPrice = cost-price snapshot per unit at the time of sale.
  unitPrice     Int
  unitCostPrice Int    @default(0) @map("unitWholesalePrice")
  tax           Int    @default(0)
  total         Int

  salesOrder SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("sales_order_items")
}

model Payment {
  id           String   @id @default(cuid())
  salesOrderId String
  amount       Int
  method       String
  date         DateTime @default(now())
  note         String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([date])
  @@map("payments")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  postalCode    String?
  country       String?
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("suppliers")
}


model Expense {
  id              String   @id @default(cuid())
  expenseSequence Int      @unique
  expenseNumber   String   @unique
  category        String
  description     String
  amount          Int
  paymentMethod   String
  expenseDate     DateTime
  recordedBy      String
  receiptUrl      String?
  notes           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [recordedBy], references: [id])

  @@index([expenseDate])
  @@index([category, expenseDate])
  @@map("expenses")
}

model DocumentTemplate {
  id        String   @id @default(cuid())
  type      String
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@map("document_templates")
}

model DailySalesSummary {
  id                String   @id @default(cuid())
  summaryDate       DateTime @unique
  totalOrders       Int      @default(0)
  totalRevenue      Int      @default(0)
  totalTaxCollected Int      @default(0)
  totalRefunds      Int      @default(0)
  netSales          Int      @default(0)
  cashTotal         Int      @default(0)
  cardTotal         Int      @default(0)
  momoTotal         Int      @default(0)
  creditTotal       Int      @default(0)
  createdAt         DateTime @default(now())

  @@map("daily_sales_summaries")
}

model DailyProfitLoss {
  id              String   @id @default(cuid())
  reportDate      DateTime @unique
  totalRevenue    Int      @default(0)
  totalExpenses   Int      @default(0)
  costOfGoodsSold Int?
  grossProfit     Int      @default(0)
  netProfitLoss   Int      @default(0)
  createdAt       DateTime @default(now())

  @@map("daily_profit_losses")
}

// Append-only audit log. Every mutation that touches money, stock, users, or
// security writes a row here so the admin/owner has a tamper-evident trail.
model AuditLog {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  action     String
  userId     String
  reason     String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
