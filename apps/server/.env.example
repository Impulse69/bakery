# Database Configuration
# Main database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bakery?schema=public"

# Direct connection string for migrations (optional, used for Supabase or similar)
DIRECT_URL="postgresql://user:password@localhost:5432/bakery"

# Server Configuration
PORT=3001
NODE_ENV=development

# Security
# REQUIRED: Secret key for signing JWT tokens. 
# The server will crash if this is not provided.
JWT_SECRET=your-secure-jwt-secret-here

# SMS Alerts (Texify API)
TEXIFY_API_KEY=your-texify-api-key-here
TEXIFY_SENDER_ID=BAKERY
ALERT_PHONE_NUMBER=233200000000

# CORS Configuration
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://your-app.com,https://dashboard.your-app.com
